# Copy to .env (./docker/setup.sh does this for you) and fill in.

# --- Nova (Hermes) ----------------------------------------------------------------------
# Hermes image: pin a version tag here to control upgrades.
HERMES_IMAGE=nousresearch/hermes-agent:latest
# Nova's data (config, API keys, conversations, cron jobs) lives in the Docker volume
# nova-data. To keep it in a folder instead, give a path, e.g. /srv/nova
#NOVA_DATA=nova-data
# User Hermes runs as inside the container (and the collector with it).
HERMES_UID=10000
HERMES_GID=10000

# --- Mission Control --------------------------------------------------------------------
# Shared secret between the hub and the collectors (setup.sh generates one).
HMC_TOKEN=
# Viewer password hash: python3 hub/hub.py --hash-password   (empty = no password)
HMC_VIEW_PASSWORD_HASH=
# Where the dashboard port is published on this machine. Keep it on localhost and let
# "tailscale serve" put it on your tailnet (setup.sh does), or use your Tailscale IP,
# e.g. 100.101.102.103:8788 (then Docker must start after Tailscale is up).
HMC_PUBLISH=127.0.0.1:8788
# 0 = numbers only (no titles, activity or task goals)
HMC_SHOW_TEXT=1
HMC_IDLE_INTERVAL=60
# 1 = show every container on this machine on the Containers tab; 0 = only this stack's
HMC_DOCKER_ALL=1
# "Machine health" link in the header, e.g. http://hermes-box:8787
HMC_GARAGE_URL=
